# Environment Configuration for Road-Damage Repair Prioritization Agent

# ==============================================================================
# DUAL-MODE REASONING SWITCH
# ==============================================================================
# Set to 'true' to use a live LLM API for ReAct reasoning & attribute extraction.
# Set to 'false' to use the 100% offline, deterministic rule-based engine.
USE_REAL_LLM=false

# LLM Provider selection: 'auto', 'google', 'openai', or 'anthropic'
# If set to 'auto', it automatically selects whichever API key is populated below.
LLM_PROVIDER="auto"

# LLM API Keys (Populate the key for your provider if USE_REAL_LLM=true)
GOOGLE_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional Custom Model Overrides (defaults to lightweight fast models)
# GOOGLE_MODEL="gemini-1.5-flash"
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# ==============================================================================
# OBSERVABILITY & TRACING (Optional)
# ==============================================================================
# LangSmith Observability & Tracing (Set to true to export traces to LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="road-damage-prioritization-agent"

# Arize Phoenix Observability (Optional)
PHOENIX_COLLECTOR_ENDPOINT="http://127.0.0.1:6006"
PHOENIX_PROJECT_NAME="road-damage-agent"

# ==============================================================================
# APPLICATION & WARD SETTINGS
# ==============================================================================
DATABASE_PATH="data/maintenance_db.sqlite"
CHECKPOINT_DB_PATH="data/checkpoints.sqlite"
WARD_NAME="Bengaluru Ward 34 D.V Gundappa Ward"
UNIT_RATE_INR_PER_SQM=1200
COST_GATE_THRESHOLD_INR=25000
