# Environment Configuration for Road-Damage Repair Prioritization Agent

# LangSmith Observability & Tracing (Set to true to export traces to LangSmith dashboard)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="road-damage-prioritization-agent"

# Arize Phoenix Observability (Optional)
PHOENIX_COLLECTOR_ENDPOINT="http://127.0.0.1:6006"
PHOENIX_PROJECT_NAME="road-damage-agent"

# LLM Providers (Optional - The agent defaults to deterministic ReAct reasoning engine if keys are absent)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Application Settings
DATABASE_PATH="data/maintenance_db.sqlite"
CHECKPOINT_DB_PATH="data/checkpoints.sqlite"
WARD_NAME="Bengaluru Ward 34 D.V Gundappa Ward"
UNIT_RATE_INR_PER_SQM=1200
COST_GATE_THRESHOLD_INR=25000
